{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desh-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Served at https://deshapi.riadul.com (Cloudflare creates the DNS record and certificate).
  // The workers.dev address stays enabled so older links keep working.
  "routes": [{ "pattern": "deshapi.riadul.com", "custom_domain": true }],
  "workers_dev": true,
  // Scheduled warmup of live datasets (BAJUS gold and TCB daily retail prices)
  // Runs at 03:00 and 06:00 UTC (09:00 and 12:00 BST).
  "triggers": {
    "crons": ["0 3,6 * * *"]
  },
  "observability": {
    "enabled": true,
    // Invocation logs record full request URLs, which can contain NID/phone numbers.
    // We emit our own route-template-only log line instead (see src/lib/logger.ts).
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Last good copy of live data (BAJUS gold prices) for regions where the source refuses requests.
  "kv_namespaces": [{ "binding": "LIVE_DATA", "id": "f72b59d7f98c4f7fb4fe16f6cce52ce3" }],
  "vars": {
    "VERSION": "dev"
  }
}
